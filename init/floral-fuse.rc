service floral-fuse-bind /system/bin/floral_fuse_bind --verify-only
    class core
    user root
    group root
    disabled
    oneshot

# Android mounts its final procfs during early boot. Apply the optional
# LXCFS views only after that mount is in place.
on post-fs-data && property:ro.boot.floral_fuse=lxcfs
    floral_fuse_bind

# Retry once after boot in case a later early-boot action replaced procfs.
on property:sys.boot_completed=1 && property:ro.boot.floral_fuse=lxcfs
    floral_fuse_bind
