package {
    default_applicable_licenses: ["runtime_floral_fuse_license"],
}

license {
    name: "runtime_floral_fuse_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_defaults {
    name: "floral_fuse_bind_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    static_libs: ["libc++fs"],
}

cc_binary {
    name: "floral_fuse_bind",
    defaults: ["floral_fuse_bind_defaults"],
    srcs: [
        "src/floral_fuse_bind.cpp",
    ],
    static_libs: ["libfloral_fuse", "libfloral_fuse_lxcfs"],
    shared_libs: ["libbase"],
    init_rc: ["init/floral-fuse.rc"],
}

cc_library_static {
    name: "libfloral_fuse_lxcfs",
    defaults: ["floral_fuse_bind_defaults"],
    recovery_available: true,
    srcs: ["src/lxcfs_bind.cpp", "src/sysfs_mask.cpp"],
    static_libs: ["libfloral_fuse"],
    shared_libs: ["libbase"],
}

cc_library_static {
    name: "libfloral_fuse",
    defaults: ["floral_fuse_bind_defaults"],
    recovery_available: true,
    srcs: ["src/boot_config.cpp", "src/fuse_view.cpp", "src/mount_info.cpp"],
    export_include_dirs: ["src"],
    header_libs: ["libbase_headers"],
}

cc_test_host {
    name: "floral_fuse_sysfs_mask_test",
    defaults: ["floral_fuse_bind_defaults"],
    local_include_dirs: ["src"],
    srcs: [
        "src/sysfs_mask.cpp",
        "tests/sysfs_mask_test.cpp",
    ],
}

cc_test_host {
    name: "floral_fuse_bind_test",
    defaults: ["floral_fuse_bind_defaults"],
    local_include_dirs: ["src"],
    srcs: [
        "src/mount_info.cpp",
        "tests/mount_info_test.cpp",
    ],
}
